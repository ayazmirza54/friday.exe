{
	"name": "friday",
	"productName": "Friday",
	"version": "0.1.0",
	"description": "Talk to your PC. Claude does the work.",
	"author": "Friday",
	"main": "src/main.js",
	"private": true,
	"license": "MIT",
	"scripts": {
		"start": "electron .",
		"test": "node --test \"src/*.test.js\"",
		"brain": "node build-brain.js",
		"dist": "npm run brain && electron-builder --win nsis",
		"dist:portable": "npm run brain && electron-builder --win portable"
	},
	"dependencies": {
		"ws": "8.23.0"
	},
	"devDependencies": {
		"electron": "45.4.1",
		"electron-builder": "26.18.1"
	},
	"build": {
		"appId": "com.friday.exe",
		"productName": "Friday",
		"files": ["src/**/*", "assets/**/*", "!src/*.test.js"],
		"asarUnpack": ["src/control.ps1"],
		"extraResources": [{ "from": "brain/friday-brain.exe", "to": "brain/friday-brain.exe" }],
		"win": { "target": "nsis", "icon": "assets/icon.png", "artifactName": "Friday-Setup-${version}.exe" },
		"nsis": { "oneClick": true, "perMachine": false },
		"portable": { "artifactName": "Friday.exe" }
	}
}
